<view class="page">
  <view class="tabs">
    <view class="tab {{tab==='phone'?'on':''}}" data-tab="phone" bindtap="switchTab">手机号登录</view>
    <view class="tab {{tab==='wechat'?'on':''}}" data-tab="wechat" bindtap="switchTab">微信授权登录</view>
  </view>

  <block wx:if="{{tab==='phone'}}">
    <view class="row">
      <text class="label">手机号</text>
      <input class="ipt" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="row">
      <text class="label">验证码</text>
      <input class="ipt" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCode" />
      <view class="sms {{(counting || sending) ? 'dis' : ''}}" bindtap="sendSms">
        {{counting ? countdown + 's' : '获取验证码'}}
      </view>
    </view>
    <view class="btn {{loggingIn ? 'dis' : ''}}" bindtap="phoneLogin">{{loggingIn ? '登录中…' : '手机号登录'}}</view>
    <view class="tip">演示环境：验证码会直接显示，也可填 123456</view>
    <view class="btn ghost" bindtap="wechatLogin">微信一键登录</view>
  </block>

  <block wx:else>
    <view class="wx-box">
      <view class="wx-logo">🍹</view>
      <view class="wx-title">微信授权登录</view>
      <view class="wx-desc">授权后将自动创建或绑定会员账号</view>
    </view>
    <view class="btn {{loggingIn ? 'dis' : ''}}" bindtap="wechatLogin">{{loggingIn ? '登录中…' : '微信授权登录'}}</view>
    <view class="btn ghost" data-tab="phone" bindtap="switchTab">使用手机号登录</view>
  </block>
</view>
