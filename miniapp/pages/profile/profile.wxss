.page { padding: 40rpx 48rpx; }
.avatar-box { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0; }
.avatar { width: 180rpx; height: 180rpx; border-radius: 50%; background: #f1ece5; }
.avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 90rpx; }
.ava-btn { margin-top: 24rpx; background: #fff3f2; color: #e8332d; border-radius: 36rpx; font-size: 26rpx; width: 240rpx; text-align: center; line-height: 72rpx; height: 72rpx; }
.hint { margin-top: 14rpx; font-size: 22rpx; color: #999; }
.form { background: #fff; border-radius: 20rpx; padding: 8rpx 26rpx; margin-top: 30rpx; }
.row { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #f6f2ec; }
.row:last-child { border-bottom: none; }
.label { width: 120rpx; font-size: 28rpx; color: #333; }
.ipt { flex: 1; font-size: 30rpx; }
.save { margin-top: 60rpx; background: #e8332d; color: #fff; border-radius: 44rpx; font-size: 30rpx; text-align: center; line-height: 88rpx; height: 88rpx; }
.save.dis { opacity: .6; }
